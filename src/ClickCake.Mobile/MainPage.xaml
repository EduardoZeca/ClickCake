<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ClickCake.Mobile"
             xmlns:models="clr-namespace:ClickCake.Mobile.Models"
             x:Class="ClickCake.Mobile.MainPage"
             x:DataType="local:MainPage"
             Title="ClickCake"
             BackgroundColor="#F8FAFC">
    <ContentPage.Resources>
        <Style TargetType="Picker">
            <Setter Property="BackgroundColor" Value="#E2E8F0" />
            <Setter Property="TitleColor" Value="#334155" />
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HeightRequest" Value="54" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="18,24" Spacing="16">
            <Label Text="ClickCake" FontSize="29" FontAttributes="Bold" TextColor="#1E293B" />
            <Label Text="Aplicativo do vendedor" FontSize="15" TextColor="#475569" />

            <VerticalStackLayout x:Name="AreaLogin" Spacing="12">
                <Label Text="Entrar" FontSize="22" FontAttributes="Bold" TextColor="#1E293B" />
                <Entry x:Name="EntradaLogin" Placeholder="Login" ClearButtonVisibility="WhileEditing"
                       Keyboard="Text" ReturnType="Next" TextColor="Black"/>
                <Entry x:Name="EntradaSenha" Placeholder="Senha" IsPassword="True"
                       ReturnType="Done" TextColor="Black"/>
                <Button x:Name="BotaoEntrar" Text="Entrar" Clicked="AoEntrar"
                        BackgroundColor="#1D4ED8" TextColor="White" />
                <Label x:Name="MensagemLogin" TextColor="#B91C1C" FontSize="13" />
                <Label Text="O primeiro acesso exige conexao com a API."
                       FontSize="12" TextColor="#64748B" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="AreaDados" IsVisible="False" Spacing="14">
                <Label x:Name="UsuarioLogado" FontSize="20" FontAttributes="Bold" TextColor="#1E293B" />
                <Label x:Name="ResumoLocal" FontSize="12" TextColor="#475569" />
                <HorizontalStackLayout Spacing="10">
                    <Button x:Name="BotaoSincronizar" Text="Sincronizar" Clicked="AoSincronizar"
                            BackgroundColor="#1D4ED8" TextColor="White" />
                    <Button x:Name="BotaoSair" Text="Sair" Clicked="AoSair"
                            BackgroundColor="#475569" TextColor="White" />
                </HorizontalStackLayout>
                <Label x:Name="MensagemSincronizacao" FontSize="13" TextColor="#334155" />

                <Border Padding="12" BackgroundColor="White" Stroke="#94A3B8" StrokeThickness="1">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="PedidosGerais e visitas" FontSize="20" FontAttributes="Bold" TextColor="#1E293B" />
                        <Button Text="Iniciar novo ciclo" Clicked="AoNovoCiclo"
                                BackgroundColor="#047857" TextColor="White" />
                        <Label Text="Rascunhos deste vendedor" FontAttributes="Bold" TextColor="#334155" />
                        <VerticalStackLayout x:Name="ListaCiclos" Spacing="8" />
                        <Label x:Name="MensagemCiclos" TextColor="#334155" FontSize="13" />

                        <VerticalStackLayout x:Name="AreaCiclo" IsVisible="False" Spacing="10">
                            <Label x:Name="CicloSelecionado" FontSize="17" FontAttributes="Bold" TextColor="#1E293B" />
                            <HorizontalStackLayout Spacing="8">
                                <Button x:Name="BotaoPausarCiclo" Text="Pausar ciclo" Clicked="AoPausarCiclo"
                                        BackgroundColor="#475569" TextColor="White" />
                                <Button x:Name="BotaoEnviarLote" Text="Enviar lote" Clicked="AoEnviarLote"
                                        BackgroundColor="#1D4ED8" TextColor="White" />
                            </HorizontalStackLayout>
                            <Label x:Name="MensagemCicloAtual" TextColor="#334155" FontSize="13" />

                            <VerticalStackLayout x:Name="AreaAtendimento" IsVisible="False" Spacing="9">
                                <Label x:Name="ProximaVisita" FontAttributes="Bold" FontSize="17" TextColor="#1E293B" />
                                <Picker x:Name="EscolhaCategoria" Title="Categoria" TextColor="Black"
                                        SelectedIndexChanged="AoEscolherCategoria" />
                                <Picker x:Name="EscolhaProduto" Title="Produto do catalogo" TextColor="Black" />
                                <Entry x:Name="EntradaQuantidade" Placeholder="Quantidade" Keyboard="Numeric" TextColor="Black" />
                                <Button Text="Adicionar item ao carrinho" Clicked="AoAdicionarItem"
                                        BackgroundColor="#0F766E" TextColor="White" />
                                <VerticalStackLayout x:Name="ListaCarrinho" Spacing="5" />
                                <Picker x:Name="EscolhaCondicao" Title="Condicao de pagamento" TextColor="Black"
                                        SelectedIndexChanged="AoEscolherCondicao" />
                                <VerticalStackLayout x:Name="FormasParcelas" Spacing="7" />
                                <Label x:Name="TotalCarrinho" TextColor="#1E293B" FontAttributes="Bold" />
                                <Button x:Name="BotaoSalvarPedido" Text="Acrescentar pedido a lista" Clicked="AoSalvarPedido"
                                        BackgroundColor="#047857" TextColor="White" />
                                <Button x:Name="BotaoPularVisita" Text="Pular proximo cliente" Clicked="AoPularVisita"
                                        BackgroundColor="#B45309" TextColor="White" />
                            </VerticalStackLayout>

                            <Label Text="Motivo para pular/remover pedido:" TextColor="#334155" />
                            <Picker x:Name="EscolhaMotivo" Title="Motivo de pulo" TextColor="Black">
                                <Picker.Items>
                                    <x:String>Nao fara pedido</x:String>
                                    <x:String>Local fechado</x:String>
                                    <x:String>Indisponivel</x:String>
                                    <x:String>Outro</x:String>
                                </Picker.Items>
                            </Picker>
                            <Entry x:Name="EntradaObservacao" Placeholder="Observacao (obrigatoria para Outro)"
                                   MaxLength="500" TextColor="Black" />
                            <Label Text="Resumo do ciclo" FontSize="17" FontAttributes="Bold" TextColor="#1E293B" />
                            <VerticalStackLayout x:Name="ListaResumo" Spacing="6" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="12" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Minha rota" FontAttributes="Bold" FontSize="19" TextColor="#1E293B" />
                        <Label x:Name="StatusClientes" FontSize="12" TextColor="#64748B" />
                        <VerticalStackLayout Spacing="5" BindableLayout.ItemsSource="{Binding Clientes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ClienteExibicao">
                                    <Label Text="{Binding Resumo}" LineBreakMode="WordWrap"
                                           Padding="4" TextColor="#0F172A" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="12" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Catalogo de produtos" FontAttributes="Bold" FontSize="19" TextColor="#1E293B" />
                        <Label x:Name="StatusProdutos" FontSize="12" TextColor="#64748B" />
                        <VerticalStackLayout Spacing="5" BindableLayout.ItemsSource="{Binding Produtos}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ProdutoExibicao">
                                    <Label Text="{Binding Resumo}" LineBreakMode="WordWrap"
                                           Padding="4" TextColor="#0F172A" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="12" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Condicoes de pagamento" FontAttributes="Bold" FontSize="19" TextColor="#1E293B" />
                        <Label x:Name="StatusCondicoes" FontSize="12" TextColor="#64748B" />
                        <VerticalStackLayout Spacing="5" BindableLayout.ItemsSource="{Binding Condicoes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CondicaoExibicao">
                                    <Label Text="{Binding Resumo}" LineBreakMode="WordWrap"
                                           Padding="4" TextColor="#0F172A" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
