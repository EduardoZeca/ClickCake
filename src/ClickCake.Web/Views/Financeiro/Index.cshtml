@{
    ViewData["Title"] = "Financeiro";
}

<h1 class="h3">Contas a receber</h1>
<p class="text-secondary">Recebimentos simulados e sempre integrais. Todos os calculos sao feitos na API.</p>
@Html.AntiForgeryToken()

<div id="aviso" class="alert d-none" role="alert"></div>
<div class="card mb-3"><div class="card-body"><div class="row g-2">
    <div class="col-md-3">
        <label class="form-label" for="cliente">Cliente</label>
        <select id="cliente" class="form-select"><option value="">Todos</option></select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="situacao">Situacao</label>
        <select id="situacao" class="form-select">
            <option value="">Todas</option>
            <option value="Aberta">Aberta</option>
            <option value="Vencida">Vencida</option>
            <option value="Paga">Paga</option>
        </select>
    </div>
    <div class="col-md-2"><label class="form-label" for="inicio">Vencimento inicial</label>
        <input id="inicio" type="date" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label" for="fim">Vencimento final</label>
        <input id="fim" type="date" class="form-control" /></div>
    <div class="col-md-2 d-flex align-items-end">
        <button id="filtrar" class="btn btn-primary w-100" type="button">Consultar</button>
    </div>
</div></div></div>

<div class="table-responsive"><table id="tabelaParcelas" class="table table-striped table-sm align-middle"></table></div>

<section id="painelRecebimento" class="card mt-3 d-none">
    <div class="card-body">
        <h2 id="tituloRecebimento" class="h5">Registrar recebimento</h2>
        <label for="dataRecebimento" class="form-label">Data do recebimento integral</label>
        <input id="dataRecebimento" class="form-control" type="date" style="max-width:230px" />
        <button id="simular" type="button" class="btn btn-outline-primary mt-2">Calcular na API</button>
        <div id="resultadoSimulacao" class="mt-3"></div>
        <div class="mt-3 d-flex gap-2">
            <button id="confirmar" type="button" class="btn btn-success d-none">Confirmar recebimento integral</button>
            <button id="fechar" type="button" class="btn btn-outline-secondary">Fechar</button>
        </div>
    </div>
</section>

@section Scripts {
<script>
const csrf=document.querySelector('input[name="__RequestVerificationToken"]').value;
const campo=(o,n)=>o?.[n] ?? o?.[n.charAt(0).toLowerCase()+n.slice(1)];
const dinheiro=new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'});
const valor=v=>dinheiro.format(Number(v??0));
const dataIso=v=>v ? String(v).substring(0,10) : '';
const dataPt=v=>dataIso(v).split('-').reverse().join('/');
let parcelaAtual=null;
let previaAtual=null;

function avisar(mensagem,erro=false) {
    const el=document.getElementById('aviso');
    el.className='alert '+(erro?'alert-danger':'alert-success');
    el.textContent=mensagem;
}
async function consultar(url,metodo='GET',dados=null) {
    const opcoes={method:metodo,headers:{}};
    if (metodo!=='GET') {
        opcoes.headers['RequestVerificationToken']=csrf;
        opcoes.headers['Content-Type']='application/json';
        opcoes.body=JSON.stringify(dados);
    }
    const res=await fetch(url,opcoes);
    if (res.status===401) { location.href='/Conta/Login'; throw Error('Sessao expirada.'); }
    const body=await res.text();
    let obj=null;
    try { obj=body?JSON.parse(body):null; } catch { }
    if (!res.ok) throw Error(obj?.mensagem || obj?.title || ('HTTP '+res.status));
    return obj;
}
function linhaTabela(corpo,conteudos) {
    const tr=document.createElement('tr');
    for (const conteudo of conteudos) {
        const td=document.createElement('td');
        td.textContent=String(conteudo??'');
        tr.appendChild(td);
    }
    corpo.appendChild(tr);
    return tr;
}
function novaTabela(colunas) {
    const tabela=document.getElementById('tabelaParcelas');
    tabela.replaceChildren();
    const th=document.createElement('thead'),head=document.createElement('tr');
    for (const nome of colunas) {
        const cel=document.createElement('th');cel.textContent=nome;head.appendChild(cel);
    }
    th.appendChild(head);tabela.appendChild(th);
    const corpo=document.createElement('tbody');tabela.appendChild(corpo);
    return corpo;
}
async function carregarClientes() {
    const clientes=await consultar('/Admin/Dados?tipo=clientes');
    const select=document.getElementById('cliente');
    for (const c of clientes) {
        const op=document.createElement('option');
        op.value=campo(c,'Id');op.textContent=campo(c,'Nome');
        select.appendChild(op);
    }
}
async function carregar() {
    const filtros=new URLSearchParams();
    for (const id of ['cliente','situacao','inicio','fim']) {
        const v=document.getElementById(id).value;
        if (v) filtros.set(id==='cliente'?'clienteId':id,v);
    }
    const parcelas=await consultar('/Financeiro/Parcelas?'+filtros);
    const corpo=novaTabela(['Parcela','Cliente','Vendedor','Forma','Vencimento',
        'Valor base','Situacao','Pago','Acao']);
    for (const p of parcelas) {
        const tr=linhaTabela(corpo,[
            '#'+campo(p,'Id')+' ('+campo(p,'NumeroParcela')+')',
            campo(p,'Cliente'),campo(p,'Vendedor'),campo(p,'FormaPagamento'),
            dataPt(campo(p,'Vencimento')),valor(campo(p,'ValorBase')),
            campo(p,'SituacaoExibicao'),campo(p,'ValorRecebido')==null?'':valor(campo(p,'ValorRecebido'))
        ]);
        const td=document.createElement('td');
        if (campo(p,'Situacao')==='Aberta') {
            const bot=document.createElement('button');
            bot.type='button';bot.className='btn btn-sm btn-outline-primary';
            bot.textContent='Receber';bot.onclick=()=>abrir(p);
            td.appendChild(bot);
        } else {
            td.textContent='Registrado em '+dataPt(campo(p,'DataRecebimento'));
        }
        tr.appendChild(td);
    }
    if (!parcelas.length) {
        const tr=linhaTabela(corpo,['Nenhuma parcela encontrada.']);
        tr.firstElementChild.colSpan=9;
    }
}
function abrir(p) {
    parcelaAtual=p;
    previaAtual=null;
    document.getElementById('tituloRecebimento').textContent='Parcela #'+campo(p,'Id')+
        ' - '+campo(p,'Cliente');
    const hoje=new Date();
    document.getElementById('dataRecebimento').value=[
        hoje.getFullYear(),
        String(hoje.getMonth()+1).padStart(2,'0'),
        String(hoje.getDate()).padStart(2,'0')
    ].join('-');
    document.getElementById('resultadoSimulacao').replaceChildren();
    document.getElementById('confirmar').classList.add('d-none');
    document.getElementById('painelRecebimento').classList.remove('d-none');
    document.getElementById('painelRecebimento').scrollIntoView({behavior:'smooth'});
}
async function simular() {
    if (!parcelaAtual) return;
    const id=campo(parcelaAtual,'Id');
    const data=document.getElementById('dataRecebimento').value;
    if (!data) throw Error('Informe a data do recebimento.');
    previaAtual=null;
    document.getElementById('confirmar').classList.add('d-none');
    const p=await consultar('/Financeiro/Simular?id='+id+'&data='+encodeURIComponent(data));
    previaAtual=p;
    const informacoes=[
        'Cliente: '+campo(p,'Cliente'),
        'Parcela: '+campo(p,'NumeroParcela'),
        'Base: '+valor(campo(p,'ValorBase')),
        'Vencimento: '+dataPt(campo(p,'Vencimento')),
        'Recebimento: '+dataPt(campo(p,'DataRecebimento')),
        'Diferenca de dias: '+campo(p,'Dias')+' (negativo = antecipado)',
        'Multa: '+valor(campo(p,'Multa')),
        'Juros: '+valor(campo(p,'Juros')),
        'Desconto por antecipacao: '+valor(campo(p,'DescontoAntecipacao')),
        'Valor integral a registrar: '+valor(campo(p,'ValorPago'))
    ];
    const div=document.getElementById('resultadoSimulacao');div.replaceChildren();
    for (const item of informacoes) {
        const linha=document.createElement('p');linha.className='mb-1';
        linha.textContent=item;div.appendChild(linha);
    }
    document.getElementById('confirmar').classList.remove('d-none');
}
async function receber() {
    if (!previaAtual || !parcelaAtual) throw Error('Calcule o pagamento primeiro.');
    const data=dataIso(campo(previaAtual,'DataRecebimento'));
    if (document.getElementById('dataRecebimento').value!==data)
        throw Error('Data alterada. Calcule novamente antes de confirmar.');
    if (!confirm('Confirmar recebimento INTEGRAL de '+valor(campo(previaAtual,'ValorPago'))+'?'))
        return;
    const id=campo(parcelaAtual,'Id');
    const res=await consultar('/Financeiro/Receber?id='+id,'POST',{dataRecebimento:data});
    document.getElementById('painelRecebimento').classList.add('d-none');
    await carregar();
    avisar(res.mensagem);
}
async function executar(funcao) {
    try { await funcao(); } catch(e) { avisar(e.message||'Erro.',true); }
}
document.getElementById('filtrar').onclick=()=>executar(carregar);
document.getElementById('simular').onclick=()=>executar(simular);
document.getElementById('confirmar').onclick=()=>executar(receber);
document.getElementById('fechar').onclick=()=>
    document.getElementById('painelRecebimento').classList.add('d-none');
executar(async()=>{await carregarClientes();await carregar();});
</script>
}
