@{
    ViewData["Title"] = "Administracao";
}

<h1 class="h3 mb-3">Painel administrativo</h1>
<p class="text-secondary">Cadastros, estoque, pagamentos e programacao de visitas.</p>
@Html.AntiForgeryToken()

<div id="aviso" class="alert d-none" role="alert"></div>
<div class="mb-3">
    <label class="form-label" for="tela">Area de trabalho</label>
    <select id="tela" class="form-select">
        <option value="estados">Estados</option>
        <option value="cidades">Cidades</option>
        <option value="vendedores">Vendedores</option>
        <option value="clientes">Clientes</option>
        <option value="categorias">Categorias</option>
        <option value="produtos">Produtos e estoque</option>
        <option value="formas">Formas de pagamento</option>
        <option value="condicoes">Condicoes de pagamento (consulta)</option>
        <option value="rotas">Carteiras e rotas programadas</option>
    </select>
</div>

<section id="secaoCadastro">
    <div id="filtroProduto" class="row g-2 mb-3 d-none">
        <div class="col-auto">
            <select id="validade" class="form-select">
                <option value="todos">Todos os produtos</option>
                <option value="proximos">Proximos do vencimento</option>
                <option value="vencidos">Vencidos</option>
            </select>
        </div>
        <div class="col-auto">
            <select id="dias" class="form-select">
                <option value="7">7 dias</option>
                <option value="15">15 dias</option>
                <option value="30">30 dias</option>
            </select>
        </div>
        <div class="col-auto"><button type="button" id="filtrar" class="btn btn-outline-primary">Filtrar</button></div>
    </div>

    <div class="card mb-3" id="cardFormulario">
        <div class="card-header" id="tituloFormulario">Novo cadastro</div>
        <div class="card-body">
            <form id="formCadastro">
                <div class="row g-3" id="camposFormulario"></div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Salvar</button>
                    <button type="button" id="novo" class="btn btn-outline-secondary">Limpar</button>
                </div>
            </form>
        </div>
    </div>
    <div class="table-responsive"><table class="table table-striped table-sm align-middle" id="tabelaCadastros"></table></div>
</section>

<section id="secaoRotas" class="d-none">
    <div class="alert alert-info">As alteracoes programadas entram em vigor em novos ciclos iniciados apos a antecedencia minima de 24 horas. Ciclos ja iniciados preservam o roteiro original.</div>
    <div class="row g-3 mb-3">
        <div class="col-md-5">
            <label class="form-label" for="vendedorRota">Vendedor</label>
            <select id="vendedorRota" class="form-select"></select>
        </div>
        <div class="col-md-5">
            <label class="form-label" for="vigencia">Inicio de vigencia (hora local)</label>
            <input type="datetime-local" id="vigencia" class="form-control" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="button" class="btn btn-primary w-100" id="programar">Programar</button>
        </div>
    </div>
    <h2 class="h5">Composicao da proxima rota</h2>
    <p class="text-secondary small">Marque os clientes que devem integrar a rota. Informe codigo e ordem exclusivos. Para transferencia, programe primeiro a retirada da rota de origem.</p>
    <div class="table-responsive"><table class="table table-sm" id="tabelaRotas"></table></div>
    <h2 class="h5 mt-4">Programacoes futuras</h2>
    <div id="rotasFuturas" class="text-secondary">Nenhuma programacao.</div>
</section>

@section Scripts {
<script>
const csrf = document.querySelector('input[name="__RequestVerificationToken"]').value;
const definicoes = {
    estados: { campos: [['Nome','text'],['Sigla','text']], colunas: ['Id','Nome','Sigla'] },
    cidades: { campos: [['EstadoId','select','estados'],['Nome','text']], colunas: ['Id','Nome','Estado'] },
    vendedores: { campos: [['Nome','text'],['Login','text'],['Senha','password',null,'novo'],['NovaSenha','password',null,'edicao'],['Ativo','check',null,'edicao']], colunas: ['Id','Nome','Login','Ativo'] },
    clientes: { campos: [['VendedorId','select','vendedores','novo'],['CodigoVisita','number',null,'novo'],['Nome','text'],['CidadeId','select','cidades'],['Documento','text'],['Telefone','text'],['Email','text'],['Logradouro','text'],['Numero','text'],['Complemento','text'],['Bairro','text'],['Cep','text']], colunas: ['Id','Nome','Vendedor','CodigoVisita','OrdemVisita','Cidade','Ativo'] },
    categorias: { campos: [['Nome','text'],['Ativo','check']], colunas: ['Id','Nome','Ativo'] },
    produtos: { campos: [['CategoriaId','select','categorias'],['Nome','text'],['Descricao','text'],['Preco','decimal'],['Estoque','number'],['DataValidade','date'],['Ativo','check']], colunas: ['Id','Nome','Categoria','Preco','Estoque','DataValidade','Ativo'] },
    formas: { campos: [['Nome','text'],['Ativo','check']], colunas: ['Id','Nome','Ativo'] },
    condicoes: { campos: [], colunas: ['Id','Nome','QuantidadeParcelas','PrazosDias','DescontoAVista'] }
};
const rotulos = { EstadoId:'Estado',CategoriaId:'Categoria',CidadeId:'Cidade',VendedorId:'Vendedor',CodigoVisita:'Codigo de visita',DataValidade:'Validade',NovaSenha:'Nova senha (opcional)',Ativo:'Ativo',Preco:'Preco (R$)',Estoque:'Quantidade em estoque' };
const cache = {};
let tipoAtual = 'estados';
let dadosAtuais = [];
let editandoId = null;
let rotaAtual = [];

function valor(obj, nome) { return obj?.[nome] ?? obj?.[nome.charAt(0).toLowerCase()+nome.slice(1)]; }
function avisar(mensagem, erro=false) {
    const caixa = document.getElementById('aviso');
    caixa.className = 'alert ' + (erro ? 'alert-danger' : 'alert-success');
    caixa.textContent = mensagem;
}
async function requisitar(url, metodo='GET', dados=null) {
    const opcoes = { method:metodo, headers:{} };
    if (metodo !== 'GET') {
        opcoes.headers['RequestVerificationToken'] = csrf;
        if (dados !== null) {
            opcoes.headers['Content-Type']='application/json';
            opcoes.body=JSON.stringify(dados);
        }
    }
    const resposta = await fetch(url, opcoes);
    if (resposta.status===401) { location.href='/Conta/Login'; throw Error('Sessao expirada.'); }
    const texto = await resposta.text();
    let resultado = null;
    try { resultado = texto ? JSON.parse(texto) : null; } catch { resultado = null; }
    if (!resposta.ok) throw Error(resultado?.mensagem || resultado?.title || ('HTTP '+resposta.status));
    return resultado;
}
async function listar(tipo, parametros='') {
    return await requisitar('/Admin/Dados?tipo='+encodeURIComponent(tipo)+parametros);
}
async function referencias(tipo) {
    if (!cache[tipo]) cache[tipo] = await listar(tipo);
    return cache[tipo];
}
function nomeOpcao(tipo, obj) {
    if (tipo==='estados') return valor(obj,'Sigla')+' - '+valor(obj,'Nome');
    return valor(obj,'Nome');
}
async function renderizarFormulario() {
    const conf = definicoes[tipoAtual];
    const div = document.getElementById('camposFormulario');
    div.replaceChildren();
    document.getElementById('tituloFormulario').textContent = editandoId ? 'Editar cadastro #'+editandoId : 'Novo cadastro';
    for (const [nome,tipo,referencia,restricao] of conf.campos) {
        if (restricao==='novo' && editandoId || restricao==='edicao' && !editandoId) continue;
        const coluna = document.createElement('div');
        coluna.className='col-md-4';
        const etiqueta = document.createElement('label');
        etiqueta.className='form-label'; etiqueta.htmlFor='campo'+nome;
        etiqueta.textContent=rotulos[nome]||nome;
        let entrada;
        if (tipo==='select') {
            entrada=document.createElement('select');
            entrada.className='form-select';
            const vazio=document.createElement('option'); vazio.value=''; vazio.textContent='Selecione'; entrada.appendChild(vazio);
            for (const item of await referencias(referencia)) {
                const op=document.createElement('option');
                op.value=valor(item,'Id'); op.textContent=nomeOpcao(referencia,item); entrada.appendChild(op);
            }
        } else {
            entrada=document.createElement('input');
            entrada.type=tipo==='check'?'checkbox':tipo==='decimal'?'number':tipo;
            entrada.className=tipo==='check'?'form-check-input ms-2':'form-control';
            if (tipo==='decimal') { entrada.step='0.01'; entrada.min='0'; }
            if (tipo==='number') entrada.min='0';
            if (tipo==='check' && !editandoId) entrada.checked=true;
        }
        entrada.id='campo'+nome; entrada.dataset.campo=nome;
        coluna.append(etiqueta,entrada); div.appendChild(coluna);
    }
}
function formatar(valorCampo) {
    if (valorCampo===true) return 'Sim';
    if (valorCampo===false) return 'Nao';
    if (valorCampo==null) return '';
    return String(valorCampo);
}
function renderizarTabela() {
    const tabela=document.getElementById('tabelaCadastros'); tabela.replaceChildren();
    const cabeca=document.createElement('thead'); const linha=document.createElement('tr');
    for (const c of [...definicoes[tipoAtual].colunas,...(tipoAtual==='condicoes'?[]:['Acoes'])]) {
        const celula=document.createElement('th'); celula.textContent=rotulos[c]||c; linha.appendChild(celula);
    }
    cabeca.appendChild(linha); tabela.appendChild(cabeca);
    const corpo=document.createElement('tbody');
    for (const item of dadosAtuais) {
        const tr=document.createElement('tr');
        for (const c of definicoes[tipoAtual].colunas) {
            const td=document.createElement('td'); td.textContent=formatar(valor(item,c)); tr.appendChild(td);
        }
        if (tipoAtual!=='condicoes') {
            const td=document.createElement('td');
            const editar=document.createElement('button'); editar.className='btn btn-sm btn-outline-primary me-1'; editar.textContent='Editar';
            editar.onclick=()=>editarItem(item); td.appendChild(editar);
            if (tipoAtual!=='clientes') {
                const excluir=document.createElement('button'); excluir.className='btn btn-sm btn-outline-danger';
                excluir.textContent=['categorias','produtos','formas','vendedores'].includes(tipoAtual)?'Desativar':'Excluir';
                excluir.onclick=()=>excluirItem(valor(item,'Id')); td.appendChild(excluir);
            }
            tr.appendChild(td);
        }
        corpo.appendChild(tr);
    }
    tabela.appendChild(corpo);
}
async function carregarCadastros() {
    const filtro=tipoAtual==='produtos'?'&validade='+document.getElementById('validade').value+'&dias='+document.getElementById('dias').value:'';
    dadosAtuais=await listar(tipoAtual,filtro);
    renderizarTabela();
}
async function editarItem(item) {
    editandoId=valor(item,'Id');
    await renderizarFormulario();
    for (const entrada of document.querySelectorAll('#camposFormulario [data-campo]')) {
        const valorCampo=valor(item,entrada.dataset.campo);
        if (entrada.type==='checkbox') entrada.checked=Boolean(valorCampo);
        else if (entrada.type==='date' && valorCampo) entrada.value=String(valorCampo).substring(0,10);
        else entrada.value=valorCampo ?? '';
    }
    window.scrollTo({top:0,behavior:'smooth'});
}
async function limpar() { editandoId=null; await renderizarFormulario(); }
async function salvar(evento) {
    evento.preventDefault();
    const dados={};
    for (const entrada of document.querySelectorAll('#camposFormulario [data-campo]')) {
        let v=entrada.type==='checkbox'?entrada.checked:entrada.value.trim();
        if (entrada.type==='number') v=v===''?0:Number(v);
        if (entrada.type==='password' && v==='') continue;
        dados[entrada.dataset.campo]=v;
    }
    try {
        const url='/Admin/Salvar?tipo='+tipoAtual+(editandoId?'&id='+editandoId:'');
        const resposta=await requisitar(url,'POST',dados);
        avisar(resposta?.mensagem || 'Registro salvo.');
        for (const chave of Object.keys(cache)) delete cache[chave];
        await limpar(); await carregarCadastros();
    } catch(e) { avisar(e.message,true); }
}
async function excluirItem(id) {
    if (!confirm('Confirma a operacao no registro '+id+'?')) return;
    try {
        await requisitar('/Admin/Excluir?tipo='+tipoAtual+'&id='+id,'POST');
        avisar('Operacao realizada.');
        for (const chave of Object.keys(cache)) delete cache[chave];
        await carregarCadastros();
    } catch(e) { avisar(e.message,true); }
}
async function trocarTela() {
    tipoAtual=document.getElementById('tela').value;
    document.getElementById('aviso').className='alert d-none';
    document.getElementById('secaoRotas').classList.toggle('d-none',tipoAtual!=='rotas');
    document.getElementById('secaoCadastro').classList.toggle('d-none',tipoAtual==='rotas');
    if (tipoAtual==='rotas') { await carregarRota(); return; }
    document.getElementById('filtroProduto').classList.toggle('d-none',tipoAtual!=='produtos');
    document.getElementById('cardFormulario').classList.toggle('d-none',tipoAtual==='condicoes');
    await limpar(); await carregarCadastros();
}

async function carregarRota() {
    const select=document.getElementById('vendedorRota');
    const vendedorAnterior=select.value;
    select.replaceChildren();
    for (const v of await listar('vendedores')) {
        if (!valor(v,'Ativo')) continue;
        const op=document.createElement('option'); op.value=valor(v,'Id'); op.textContent=valor(v,'Nome'); select.appendChild(op);
    }
    if (vendedorAnterior) select.value=vendedorAnterior;
    await atualizarRota();
}
async function atualizarRota() {
    const id=Number(document.getElementById('vendedorRota').value);
    if (!id) return;
    try {
        const resultado=await requisitar('/Admin/Rota?vendedorId='+id);
        const atual=valor(resultado,'Atual');
        const ativos=valor(atual,'Itens')||[];
        const clientes=await listar('clientes');
        rotaAtual=clientes.map(c=>{
            const item=ativos.find(x=>Number(valor(x,'ClienteId'))===Number(valor(c,'Id')));
            return { ClienteId:Number(valor(c,'Id')), Nome:valor(c,'Nome'),
                Vendedor:valor(c,'Vendedor'), Selecionado:!!item,
                CodigoVisita:Number(valor(item||c,'CodigoVisita')),
                OrdemVisita:Number(valor(item||c,'OrdemVisita')) };
        });
        desenharRota();
        const futuras=valor(resultado,'Futuras')||[];
        document.getElementById('rotasFuturas').textContent=futuras.length?
            futuras.map(f=>'Versao '+valor(f,'Id')+' — '+new Date(valor(f,'VigenciaEm')).toLocaleString('pt-BR')).join(' | '):
            'Nenhuma programacao futura.';
    } catch(e) { avisar(e.message,true); }
}
function desenharRota() {
    const tabela=document.getElementById('tabelaRotas'); tabela.replaceChildren();
    const cabeca=document.createElement('thead'); const tr=document.createElement('tr');
    for (const titulo of ['Incluir','Cliente','Vendedor atual','Codigo','Ordem']) {
        const th=document.createElement('th'); th.textContent=titulo; tr.appendChild(th);
    }
    cabeca.appendChild(tr); tabela.appendChild(cabeca);
    const corpo=document.createElement('tbody');
    rotaAtual.forEach((item,indice)=>{
        const linha=document.createElement('tr');
        const check=document.createElement('input'); check.type='checkbox'; check.checked=item.Selecionado;
        check.onchange=()=>item.Selecionado=check.checked;
        const celulaCheck=document.createElement('td'); celulaCheck.appendChild(check); linha.appendChild(celulaCheck);
        for (const texto of [item.Nome,item.Vendedor]) {
            const td=document.createElement('td'); td.textContent=texto; linha.appendChild(td);
        }
        for (const campo of ['CodigoVisita','OrdemVisita']) {
            const td=document.createElement('td'); const entrada=document.createElement('input');
            entrada.type='number'; entrada.min='1'; entrada.className='form-control form-control-sm';
            entrada.style.maxWidth='110px'; entrada.value=item[campo];
            entrada.onchange=()=>item[campo]=Number(entrada.value);
            td.appendChild(entrada); linha.appendChild(td);
        }
        corpo.appendChild(linha);
    });
    tabela.appendChild(corpo);
}
async function programarRota() {
    const vendedorId=Number(document.getElementById('vendedorRota').value);
    const campoData=document.getElementById('vigencia').value;
    if (!vendedorId || !campoData) { avisar('Selecione vendedor e data de vigencia.',true); return; }
    const itens=rotaAtual.filter(x=>x.Selecionado).map(x=>({
        ClienteId:x.ClienteId,CodigoVisita:x.CodigoVisita,OrdemVisita:x.OrdemVisita
    }));
    try {
        const resposta=await requisitar('/Admin/ProgramarRota?vendedorId='+vendedorId,'POST',{
            VigenciaEmUtc:new Date(campoData).toISOString(), Itens:itens
        });
        avisar(resposta?.mensagem || 'Rota programada.');
        await atualizarRota();
    } catch(e) { avisar(e.message,true); }
}

document.getElementById('tela').onchange=()=>trocarTela().catch(e=>avisar(e.message,true));
document.getElementById('formCadastro').onsubmit=salvar;
document.getElementById('novo').onclick=limpar;
document.getElementById('filtrar').onclick=()=>carregarCadastros().catch(e=>avisar(e.message,true));
document.getElementById('vendedorRota').onchange=atualizarRota;
document.getElementById('programar').onclick=programarRota;
trocarTela().catch(e=>avisar(e.message,true));
</script>
}
